# IMAP 邮箱（请复制为 .env；不要提交 .env）
IMAP_EMAIL=you@example.com
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# 本项目按用户要求使用本地配置文件；.env 已被 Git 忽略且应设置为 600 权限。
IMAP_PASSWORD=your_imap_app_password

# Coremail 原生“待办邮件”。非 Coremail 邮箱请保持 false。
COREMAIL_TODO_ENABLED=false
COREMAIL_WEB_URL=https://mail.example.com
COREMAIL_LOOKUP_LIMIT=200

# 任意 OpenAI-compatible Chat Completions API；以下默认值继续使用 DeepSeek 官方接口。
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_BATCH_SIZE=3
LLM_JSON_MODE=true
LLM_SYSTEM_ROLE=system
LLM_MAX_TOKENS_PARAM=max_tokens
LLM_TIMEOUT_SECONDS=90
# 可选：完整接口地址，设置后不再由 LLM_BASE_URL 拼接 /chat/completions。
# LLM_CHAT_COMPLETIONS_URL=https://gateway.example.com/v1/chat/completions
# 可选：供应商专属请求体/请求头，必须是 JSON 对象。敏感值仍只能放在本地 .env。
# LLM_EXTRA_BODY_JSON={"temperature":0.1}
# LLM_EXTRA_HEADERS_JSON={"X-Provider":"example"}
# 兼容旧配置：DEEPSEEK_API_KEY/BASE_URL/MODEL/BATCH_SIZE 仍可使用。

# 首次执行 `./tracker init-base` 后会自动回填这两项。
LARK_BASE_TOKEN=
LARK_TABLE_ID=
LARK_CLI=./node_modules/.bin/lark-cli
# 只有已确认具体时间的人工面试会创建日程；需要额外授权飞书日历。
LARK_CALENDAR_ENABLED=false

# 同步策略
SYNC_SINCE_DATE=2026-08-20
SYNC_INTERVAL_SECONDS=300
SYNC_MAX_MESSAGES=300
SYNC_MIN_CONFIDENCE=0.55
SYNC_TIMEZONE=Asia/Shanghai

# 可选：macOS 登录自启安装器会自动把 SQLite 路径设到 ~/Library/Application Support。
# TRACKER_DATABASE_PATH=/absolute/path/to/tracker.sqlite3
